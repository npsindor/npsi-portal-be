{
  "name": "npsindore-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "db:migrate": "node scripts/migrate.mjs",
    "db:import": "node scripts/import-base44-exports.mjs database",
    "db:import-users": "node scripts/import-users-export.mjs",
    "test:contract": "npm run build && CONTRACT_API=v1 CONTRACT_SERVER_CMD='node dist/main.js' node --test --test-reporter=spec tests/contract/contract.test.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "dev:legacy": "node server/index.js",
    "test:contract:legacy": "node --test --test-reporter=spec tests/contract/contract.test.mjs",
    "test": "rm -rf .test-build && tsc -p tsconfig.json && node --enable-source-maps --test --test-reporter=spec '.test-build/**/*.spec.js'",
    "test:cov": "rm -rf .test-build && tsc -p tsconfig.json && node --enable-source-maps --test --experimental-test-coverage --test-coverage-include='src/**/*.service.ts' --test-coverage-include='.test-build/**/*.service.js' --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 '.test-build/**/*.spec.js'",
    "test:e2e": "rm -rf .test-build && tsc -p tsconfig.json && node --enable-source-maps --test --test-reporter=spec --test-concurrency=1 '.test-build/**/*.e2e-spec.js'"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@nestjs/testing": "^12.1.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "~5.9"
  }
}
