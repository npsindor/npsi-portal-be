# Copy to .env (or .env.local, which takes precedence for the API server) and fill in.

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=patidar_samaj
MYSQL_USER=root
MYSQL_PASSWORD=

# API
API_PORT=4000
FRONTEND_URL=http://localhost:5173
# Number of reverse-proxy hops in front of the API (default 1; Hostinger CDN + web server is likely 2)
TRUST_PROXY=
# Environment name reported by /api/health (production, test; default development)
APP_ENV=

# File uploads directory (optional, defaults to ./uploads). Required on Hostinger, outside the
# deployed code, one folder per site: /home/u465324772/uploads-test, /home/u465324772/uploads-prod
UPLOADS_DIR=

# Google reCAPTCHA v3 secret (optional: when unset, verification is skipped)
RECAPTCHA_SECRET_KEY=

# SMTP (optional: when unset, emails are skipped and reset tokens are returned in the API response)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_NOTIFICATION_EMAILS=

# Sehat Saathi WhatsApp: enable only after provider authorization and template approval.
SEHAT_WHATSAPP_AUTHORIZED=false
SEHAT_WA_TOKEN=
SEHAT_WA_PHONE_ID=
SEHAT_WA_VERSION=
SEHAT_WA_TEMPLATE_EN=
SEHAT_WA_TEMPLATE_HI=
SEHAT_WA_LANGUAGE_EN=en_US
SEHAT_WA_LANGUAGE_HI=hi

# Optional: full Prisma connection URL (otherwise built from the MYSQL_* variables)
DATABASE_URL=

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v26.0
WHATSAPP_BUSINESS_ACCOUNT_ID=

# MSG91 — WhatsApp OTP / status messages, SMS OTP fallback (https://msg91.com). Without these, OTPs go to
# the email the user enters (and, with APP_ENV=development only, to the server console).
MSG91_AUTH_KEY=
# WhatsApp: the integrated (business) number, and approved template names; MSG91_WHATSAPP_OTP_TEMPLATE has one
# body variable (the code), MSG91_WHATSAPP_NOTICE_TEMPLATE one body variable (the message text).
MSG91_WHATSAPP_NUMBER=
MSG91_WHATSAPP_NAMESPACE=
MSG91_WHATSAPP_LANGUAGE=en
MSG91_WHATSAPP_OTP_TEMPLATE=
# true when the OTP template is a WhatsApp "authentication" template with a copy-code button
MSG91_WHATSAPP_OTP_BUTTON=false
MSG91_WHATSAPP_NOTICE_TEMPLATE=
# SMS fallback: DLT-approved flow/template id and its OTP variable name
MSG91_SMS_OTP_TEMPLATE_ID=
MSG91_SMS_OTP_VAR=otp

# Payment screenshots (private; default: a sibling of UPLOADS_DIR named <uploads>-payments-private)
PAYMENTS_PRIVATE_DIR=
