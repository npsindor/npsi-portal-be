# Copy to .env (or .env.local, which takes precedence for the API server) and fill in.

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=patidar_samaj
MYSQL_USER=root
MYSQL_PASSWORD=

# API
API_PORT=4000
FRONTEND_URL=http://localhost:5173
# Number of reverse-proxy hops in front of the API (default 1; Hostinger CDN + web server is likely 2)
TRUST_PROXY=
# Environment name reported by /api/health (production, test; default development)
APP_ENV=

# File uploads directory (optional, defaults to ./uploads)
UPLOADS_DIR=

# Google reCAPTCHA v3 secret (optional: when unset, verification is skipped)
RECAPTCHA_SECRET_KEY=

# SMTP (optional: when unset, emails are skipped and reset tokens are returned in the API response)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_NOTIFICATION_EMAILS=
