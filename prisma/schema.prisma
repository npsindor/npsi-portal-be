generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

/// Legacy sequelize-cli migration history. Kept so Prisma Migrate never drops it; not used by the app.
model SequelizeMeta {
  name String @id @unique(map: "name") @db.VarChar(255)
}

model Announcement {
  id        String    @id @db.VarChar(64)
  title     String    @db.Text
  body      String    @db.Text
  date      DateTime? @db.DateTime(0)
  type      String?   @db.VarChar(255)
  status    String?   @default("Active") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  titleHi   String?   @map("title_hi") @db.Text
  bodyHi    String?   @map("body_hi") @db.Text

  category  String?   @db.VarChar(40)
  imageUrl  String?   @map("image_url") @db.VarChar(500)
  slug      String?   @unique @db.VarChar(220)
  author    String?   @db.VarChar(150)
  publishAt DateTime? @map("publish_at") @db.DateTime(0)

  @@index([status, publishAt])
  @@map("announcements")
}

model Application {
  id                String    @id @db.VarChar(64)
  applicationId     String    @unique(map: "application_id") @map("application_id") @db.VarChar(255)
  status            String?   @default("SUBMITTED") @db.VarChar(64)
  familyHeadName    String    @map("family_head_name") @db.Text
  mobile            String?   @db.VarChar(255)
  mobileDigits      String?   @map("mobile_digits") @db.VarChar(10)
  email             String?   @db.VarChar(255)
  familyName        String    @map("family_name") @db.Text
  address           String?   @db.Text
  city              String?   @db.VarChar(255)
  district          String?   @db.VarChar(255)
  state             String?   @db.VarChar(255)
  pincode           String?   @db.VarChar(255)
  gotra             String?   @db.VarChar(255)
  nativePlace       String?   @map("native_place") @db.VarChar(255)
  village           String?   @db.VarChar(255)
  membersData       Json?     @map("members_data")
  submittedDate     DateTime? @map("submitted_date") @db.DateTime(0)
  adminRemarks      String?   @map("admin_remarks") @db.Text
  reviewedDate      DateTime? @map("reviewed_date") @db.DateTime(0)
  resultingFamilyId String?   @map("resulting_family_id") @db.VarChar(255)
  userId            String?   @map("user_id") @db.VarChar(64)
  lang              String?   @db.VarChar(4)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([applicationId, mobile], map: "applications_lookup_idx")
  @@index([mobileDigits], map: "applications_mobile_digits_idx")
  @@index([userId], map: "applications_user_id_idx")
  @@map("applications")
}

model EventRegistration {
  id              String    @id @db.VarChar(64)
  registrationId  String    @unique(map: "registration_id") @map("registration_id") @db.VarChar(255)
  eventId         String    @map("event_id") @db.VarChar(64)
  eventTitle      String?   @map("event_title") @db.VarChar(255)
  familyId        String?   @map("family_id") @db.VarChar(255)
  memberIds       Json?     @map("member_ids")
  memberNames     Json?     @map("member_names")
  count           Int?      @default(0)
  feePerMember    Decimal?  @default(0.00) @map("fee_per_member") @db.Decimal(12, 2)
  totalFee        Decimal?  @default(0.00) @map("total_fee") @db.Decimal(12, 2)
  paymentStatus   String?   @default("PENDING") @map("payment_status") @db.VarChar(64)
  transactionId   String?   @map("transaction_id") @db.VarChar(255)
  status          String?   @default("REGISTERED") @db.VarChar(64)
  registeredById  String?   @map("registered_by_id") @db.VarChar(255)
  registeredDate  DateTime? @map("registered_date") @db.DateTime(0)
  registrantName  String?   @map("registrant_name") @db.VarChar(255)
  registrantEmail String?   @map("registrant_email") @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "event_registrations_event_id_fkey")

  // "<event id>:<family id>" while the registration is not CANCELLED, NULL otherwise: one live registration per
  // family and event, even for simultaneous requests.
  activeKey String? @unique(map: "event_registrations_active_key_key") @map("active_key") @db.VarChar(400)

  @@map("event_registrations")
}

model Event {
  id                String                   @id @db.VarChar(64)
  title             String                   @db.Text
  slug              String?                  @db.VarChar(255)
  bannerUrl         String?                  @map("banner_url") @db.Text
  description       String?                  @db.Text
  date              DateTime                 @db.Date
  startTime         String?                  @map("start_time") @db.VarChar(255)
  endTime           String?                  @map("end_time") @db.VarChar(255)
  venue             String                   @db.Text
  mapLocation       String?                  @map("map_location") @db.Text
  organizer         String?                  @db.VarChar(255)
  contact           String?                  @db.VarChar(255)
  registrationOpen  DateTime?                @map("registration_open") @db.DateTime(0)
  registrationClose DateTime?                @map("registration_close") @db.DateTime(0)
  fee               Decimal?                 @default(0.00) @db.Decimal(12, 2)
  capacity          Int?
  rules             String?                  @db.Text
  terms             String?                  @db.Text
  status            String?                  @default("DRAFT") @db.VarChar(64)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  registrations     EventRegistration[]
  titleHi           String?                  @map("title_hi") @db.Text
  descriptionHi     String?                  @map("description_hi") @db.Text
  /// Events & Programs page section: GARBA (Maa Na Garba), CULTURAL (Cultural Programs) or GENERAL.
  teamJoiningOpen   Boolean                  @default(false) @map("team_joining_open")
  category          String                   @default("GENERAL") @db.VarChar(16)
  contributions     EventContribution[]
  expenses          EventExpense[]
  teams             EventTeam[]
  roster            EventRoster[]
  responsibilities  EventResponsibility[]
  rosterImports     RosterImportHistory[]
  financialAudits   EventFinancialAuditLog[]
  memberSections    EventMemberSection[]

  @@index([status, date])
  @@map("events")
}

model Family {
  id               String         @id @db.VarChar(64)
  familyId         String?        @unique(map: "family_id") @map("family_id") @db.VarChar(255)
  familyName       String?        @map("family_name") @db.Text
  headName         String?        @map("head_name") @db.Text
  status           String?        @default("PENDING") @db.VarChar(64)
  address          String?        @db.Text
  city             String?        @db.VarChar(255)
  district         String?        @db.VarChar(255)
  state            String?        @db.VarChar(255)
  pincode          String?        @db.VarChar(255)
  nativePlace      String?        @map("native_place") @db.VarChar(255)
  village          String?        @db.VarChar(255)
  gotra            String?        @db.VarChar(255)
  contactNumber    String?        @map("contact_number") @db.VarChar(255)
  contactDigits    String?        @map("contact_digits") @db.VarChar(10)
  email            String?        @db.VarChar(255)
  registrationDate DateTime?      @map("registration_date") @db.DateTime(0)
  memberCount      Int?           @default(0) @map("member_count")
  applicationId    String?        @map("application_id") @db.VarChar(255)
  ownerUserId      String?        @map("owner_user_id") @db.VarChar(64)
  /// The head's photo in the home page carousel and the family's birthday wishes: shown by default, hidden by an
  /// administrator.
  showOnHome       Boolean        @default(true) @map("show_on_home")
  createdAt        DateTime       @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  members          FamilyMember[]

  @@index([email], map: "families_email_idx")
  @@index([contactDigits], map: "families_contact_digits_idx")
  @@index([ownerUserId], map: "families_owner_user_id_idx")
  @@map("families")
}

model FamilyMember {
  id                 String              @id @db.VarChar(64)
  familyId           String              @map("family_id") @db.VarChar(64)
  membershipId       String?             @map("membership_id") @db.VarChar(255)
  name               String              @db.Text
  relationship       String              @db.VarChar(255)
  gender             String?             @db.VarChar(255)
  dob                DateTime?           @db.Date
  mobile             String?             @db.VarChar(255)
  mobileDigits       String?             @map("mobile_digits") @db.VarChar(10)
  email              String?             @db.VarChar(255)
  education          String?             @db.VarChar(255)
  occupation         String?             @db.VarChar(255)
  maritalStatus      String?             @map("marital_status") @db.VarChar(20)
  address            String?             @db.Text
  photoUrl           String?             @map("photo_url") @db.Text
  status             String?             @default("PENDING") @db.VarChar(64)
  linkedStudentId    String?             @map("linked_student_id") @db.VarChar(255)
  createdAt          DateTime            @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  family             Family              @relation(fields: [familyId], references: [familyId], onDelete: Cascade, onUpdate: Cascade, map: "family_members_family_id_fkey")
  sagunProfile       SagunProfile?
  eventContributions EventContribution[]
  eventRoster        EventRoster[]

  coreTeam                CoreTeamMember?
  eventMemberApplications EventMemberApplication[]

  @@index([familyId], map: "family_members_family_idx")
  @@index([email], map: "family_members_email_idx")
  @@index([membershipId], map: "family_members_membership_idx")
  @@index([mobileDigits], map: "family_members_mobile_digits_idx")
  @@map("family_members")
}

model ExpenseCategory {
  id        String         @id @db.VarChar(64)
  name      String         @unique(map: "event_expense_categories_name_key") @db.VarChar(160)
  nameHi    String?        @map("name_hi") @db.VarChar(160)
  active    Boolean        @default(true)
  sortOrder Int            @default(0) @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  expenses  EventExpense[]

  @@index([active, sortOrder], map: "event_expense_categories_active_sort_idx")
  @@map("event_expense_categories")
}

model EventContribution {
  id                String        @id @db.VarChar(64)
  eventId           String        @map("event_id") @db.VarChar(64)
  memberId          String?       @map("member_id") @db.VarChar(64)
  memberName        String        @map("member_name") @db.VarChar(255)
  familyId          String?       @map("family_id") @db.VarChar(255)
  village           String?       @db.VarChar(255)
  mobile            String?       @db.VarChar(20)
  amount            Decimal       @db.Decimal(12, 2)
  paymentMode       String        @map("payment_mode") @db.VarChar(32)
  paymentReference  String?       @unique(map: "event_contributions_payment_reference_key") @map("payment_reference") @db.VarChar(128)
  status            String        @default("PENDING") @db.VarChar(24)
  contributedAt     DateTime      @default(now()) @map("contributed_at") @db.DateTime(0)
  /// Line number in the source statement (e.g. the printed donor list).
  serialNo          Int?          @map("serial_no")
  /// GENERAL (Sahyog Rashi) or BHOG_PRASAD (Mataji Bhog & Prasad).
  contributionGroup String        @default("GENERAL") @map("contribution_group") @db.VarChar(24)
  notes             String?       @db.Text
  /// Set when an entry needs a Super Admin check (e.g. an unclear amount in the source statement).
  reviewNote        String?       @map("review_note") @db.Text
  /// Stable key of an imported statement line, so a re-run never creates a duplicate.
  importKey         String?       @unique(map: "event_contributions_import_key_key") @map("import_key") @db.VarChar(128)
  createdById       String        @map("created_by_id") @db.VarChar(64)
  updatedById       String?       @map("updated_by_id") @db.VarChar(64)
  deletedAt         DateTime?     @map("deleted_at") @db.DateTime(0)
  createdAt         DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  event             Event         @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "event_contributions_event_fkey")
  member            FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "event_contributions_member_fkey")

  @@index([eventId, status, contributedAt], map: "event_contributions_event_status_date_idx")
  @@index([village], map: "event_contributions_village_idx")
  @@map("event_contributions")
}

model EventExpense {
  id               String          @id @db.VarChar(64)
  eventId          String          @map("event_id") @db.VarChar(64)
  categoryId       String          @map("category_id") @db.VarChar(64)
  title            String          @db.VarChar(255)
  description      String?         @db.Text
  titleHi          String?         @map("title_hi") @db.VarChar(255)
  descriptionHi    String?         @map("description_hi") @db.Text
  /// EVENT (the event's own expenses) or ORGANIZATION (a Sangathan programme accounted with the event).
  expenseGroup     String          @default("EVENT") @map("expense_group") @db.VarChar(24)
  serialNo         Int?            @map("serial_no")
  importKey        String?         @unique(map: "event_expenses_import_key_key") @map("import_key") @db.VarChar(128)
  amount           Decimal         @db.Decimal(12, 2)
  vendorName       String?         @map("vendor_name") @db.VarChar(255)
  vendorMobile     String?         @map("vendor_mobile") @db.VarChar(20)
  invoiceNumber    String?         @map("invoice_number") @db.VarChar(128)
  expenseDate      DateTime        @map("expense_date") @db.DateTime(0)
  paymentMode      String          @map("payment_mode") @db.VarChar(32)
  paymentReference String?         @map("payment_reference") @db.VarChar(128)
  receiptUrl       String?         @map("receipt_url") @db.Text
  notes            String?         @db.Text
  paymentStatus    String          @default("PENDING") @map("payment_status") @db.VarChar(24)
  status           String          @default("PENDING") @db.VarChar(24)
  approvedById     String?         @map("approved_by_id") @db.VarChar(64)
  approvedAt       DateTime?       @map("approved_at") @db.DateTime(0)
  createdById      String          @map("created_by_id") @db.VarChar(64)
  updatedById      String?         @map("updated_by_id") @db.VarChar(64)
  deletedAt        DateTime?       @map("deleted_at") @db.DateTime(0)
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  event            Event           @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "event_expenses_event_fkey")
  category         ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "event_expenses_category_fkey")

  @@index([eventId, status, expenseDate], map: "event_expenses_event_status_date_idx")
  @@index([categoryId], map: "event_expenses_category_idx")
  @@map("event_expenses")
}

model EventTeam {
  id               String                @id @db.VarChar(64)
  eventId          String                @map("event_id") @db.VarChar(64)
  name             String                @db.VarChar(160)
  leaderName       String?               @map("leader_name") @db.VarChar(255)
  leaderMobile     String?               @map("leader_mobile") @db.VarChar(20)
  responsibilities String?               @db.Text
  status           String                @default("ACTIVE") @db.VarChar(24)
  createdById      String                @map("created_by_id") @db.VarChar(64)
  createdAt        DateTime              @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  event            Event                 @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "event_teams_event_fkey")
  members          EventRoster[]
  assignments      EventResponsibility[]

  @@unique([eventId, name], map: "event_teams_event_name_key")
  @@index([eventId, status], map: "event_teams_event_status_idx")
  @@map("event_teams")
}

model EventRoster {
  id             String                @id @db.VarChar(64)
  eventId        String                @map("event_id") @db.VarChar(64)
  memberId       String?               @map("member_id") @db.VarChar(64)
  teamId         String?               @map("team_id") @db.VarChar(64)
  memberName     String                @map("member_name") @db.VarChar(255)
  fatherName     String?               @map("father_name") @db.VarChar(255)
  village        String?               @db.VarChar(255)
  mobile         String?               @db.VarChar(20)
  familyId       String?               @map("family_id") @db.VarChar(255)
  membershipId   String?               @map("membership_id") @db.VarChar(255)
  committee      String?               @db.VarChar(160)
  responsibility String?               @db.VarChar(255)
  status         String                @default("ACTIVE") @db.VarChar(24)
  createdById    String                @map("created_by_id") @db.VarChar(64)
  updatedById    String?               @map("updated_by_id") @db.VarChar(64)
  deletedAt      DateTime?             @map("deleted_at") @db.DateTime(0)
  createdAt      DateTime              @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  event          Event                 @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "event_roster_event_fkey")
  member         FamilyMember?         @relation(fields: [memberId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "event_roster_member_fkey")
  team           EventTeam?            @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "event_roster_team_fkey")
  studentId      String?               @map("student_id") @db.VarChar(255)
  userId         String?               @map("user_id") @db.VarChar(64)
  photoUrl       String?               @map("photo_url") @db.VarChar(500)
  area           String?               @db.VarChar(150)
  showMobile     Boolean               @default(false) @map("show_mobile")
  showOnWebsite  Boolean               @default(false) @map("show_on_website")
  reviewStatus   String                @default("APPROVED") @map("review_status") @db.VarChar(16)
  reviewRemarks  String?               @map("review_remarks") @db.VarChar(500)
  source         String                @default("ADMIN") @db.VarChar(16)
  assignments    EventResponsibility[]

  @@unique([eventId, memberId], map: "event_roster_event_member_key")
  @@unique([eventId, studentId], map: "event_roster_event_student_key")
  @@index([eventId, reviewStatus, showOnWebsite], map: "event_roster_event_review_idx")
  @@index([eventId, village], map: "event_roster_event_village_idx")
  @@index([eventId, status], map: "event_roster_event_status_idx")
  @@map("event_roster")
}

model EventResponsibility {
  id           String      @id @db.VarChar(64)
  eventId      String      @map("event_id") @db.VarChar(64)
  rosterId     String      @map("roster_id") @db.VarChar(64)
  teamId       String?     @map("team_id") @db.VarChar(64)
  title        String      @db.VarChar(255)
  description  String?     @db.Text
  assignedById String      @map("assigned_by_id") @db.VarChar(64)
  startDate    DateTime?   @map("start_date") @db.DateTime(0)
  deadline     DateTime?   @db.DateTime(0)
  priority     String      @default("MEDIUM") @db.VarChar(16)
  status       String      @default("ASSIGNED") @db.VarChar(24)
  remarks      String?     @db.Text
  createdAt    DateTime    @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "event_responsibilities_event_fkey")
  roster       EventRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "event_responsibilities_roster_fkey")
  team         EventTeam?  @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "event_responsibilities_team_fkey")

  @@index([eventId, status, deadline], map: "event_responsibilities_event_status_deadline_idx")
  @@map("event_responsibilities")
}

model RosterImportHistory {
  id            String   @id @db.VarChar(64)
  eventId       String   @map("event_id") @db.VarChar(64)
  fileName      String   @map("file_name") @db.VarChar(255)
  totalRows     Int      @map("total_rows")
  importedCount Int      @map("imported_count")
  failedCount   Int      @map("failed_count")
  report        Json
  createdById   String   @map("created_by_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "roster_import_history_event_fkey")

  @@index([eventId, createdAt], map: "roster_import_history_event_date_idx")
  @@map("roster_import_history")
}

model EventFinancialAuditLog {
  id         String   @id @db.VarChar(64)
  eventId    String   @map("event_id") @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(32)
  entityId   String   @map("entity_id") @db.VarChar(64)
  action     String   @db.VarChar(24)
  actorId    String   @map("actor_id") @db.VarChar(64)
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "event_financial_audit_event_fkey")

  @@index([eventId, createdAt], map: "event_financial_audit_event_date_idx")
  @@index([entityType, entityId], map: "event_financial_audit_entity_idx")
  @@map("event_financial_audit_logs")
}

model Feedback {
  id            String    @id @db.VarChar(64)
  feedbackId    String?   @unique(map: "feedback_id") @map("feedback_id") @db.VarChar(255)
  memberName    String    @map("member_name") @db.Text
  familyId      String?   @map("family_id") @db.VarChar(255)
  email         String?   @db.VarChar(255)
  feedbackType  String?   @map("feedback_type") @db.VarChar(255)
  subject       String?   @db.VarChar(255)
  message       String?   @db.Text
  attachmentUrl String?   @map("attachment_url") @db.Text
  questions     Json?
  rating        Int?
  status        String?   @default("Submitted") @db.VarChar(64)
  reply         String?   @db.Text
  repliedDate   DateTime? @map("replied_date") @db.DateTime(0)
  repliedById   String?   @map("replied_by_id") @db.VarChar(255)
  internalNote  String?   @map("internal_note") @db.Text
  archived      Boolean   @default(false)
  submittedDate DateTime? @map("submitted_date") @db.DateTime(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([email], map: "feedback_email_idx")
  @@map("feedback")
}

model Notification {
  id                String             @id @db.VarChar(64)
  title             String             @db.Text
  message           String             @db.Text
  type              String             @db.VarChar(255)
  recipientFamilyId String?            @map("recipient_family_id") @db.VarChar(255)
