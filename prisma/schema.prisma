// Room Hunting: rental listings posted by approved family members / registered students, room requirements
// (anyone may post; anonymous ones wait for approval), the matches between them, enquiries and an audit log.
model RentalListing {
  id              String          @id @db.VarChar(64)
  reference       String          @unique @db.VarChar(20)
  clientRequestId String          @map("client_request_id") @db.VarChar(36)
  userId          String          @map("user_id") @db.VarChar(64)
  memberId        String?         @map("member_id") @db.VarChar(64)
  familyId        String?         @map("family_id") @db.VarChar(255)
  studentId       String?         @map("student_id") @db.VarChar(255)
  propertyType    String          @map("property_type") @db.VarChar(60)
  typeKey         String          @map("type_key") @db.VarChar(60)
  availableFor    String          @default("ANY") @map("available_for") @db.VarChar(16)
  rentAmount      Int             @map("rent_amount")
  area            String          @db.VarChar(150)
  areaKey         String          @map("area_key") @db.VarChar(150)
  address         String?         @db.VarChar(500)
  showAddress     Boolean         @default(false) @map("show_address")
  availableFrom   DateTime?       @map("available_from") @db.Date
  description     String?         @db.Text
  photoUrl        String?         @map("photo_url") @db.VarChar(500)
  photoUrls       Json?           @map("photo_urls")
  contactName     String          @map("contact_name") @db.VarChar(150)
  contactMobile   String          @map("contact_mobile") @db.VarChar(10)
  contactEmail    String?         @map("contact_email") @db.VarChar(254)
  showMobile      Boolean         @default(false) @map("show_mobile")
  showEmail       Boolean         @default(false) @map("show_email")
  ownerConfirmed  Boolean         @default(false) @map("owner_confirmed")
  status          String          @default("PENDING") @db.VarChar(16)
  adminRemarks    String?         @map("admin_remarks") @db.VarChar(500)
  approvedAt      DateTime?       @map("approved_at") @db.DateTime(0)
  expiresAt       DateTime?       @map("expires_at") @db.DateTime(0)
  createdAt       DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  matches         RentalMatch[]
  enquiries       RentalEnquiry[]

  @@unique([userId, clientRequestId])
  @@index([status, typeKey, areaKey, rentAmount])
  @@index([userId, createdAt])
  @@map("rental_listings")
}

