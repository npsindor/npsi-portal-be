  createdAt     DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  member        FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "core_team_members_member_fkey")

  @@index([status, sortOrder], map: "core_team_members_status_order_idx")
  @@map("core_team_members")
}

/// "Become an NPSI Event Member": the teams people apply to (Core Team, Deepotsav Team, …), optionally shown on an event page.
model EventMemberSection {
  id           String                   @id @db.VarChar(64)
  key          String                   @unique(map: "event_member_sections_key_key") @db.VarChar(40)
  label        String                   @db.VarChar(150)
  labelHi      String?                  @map("label_hi") @db.VarChar(150)
  heading      String                   @db.VarChar(150)
  headingHi    String?                  @map("heading_hi") @db.VarChar(150)
  eventId      String?                  @map("event_id") @db.VarChar(64)
  isCoreTeam   Boolean                  @default(false) @map("is_core_team")
  accepting    Boolean                  @default(true)
  status       String                   @default("ACTIVE") @db.VarChar(16)
  sortOrder    Int                      @default(0) @map("sort_order")
  createdAt    DateTime                 @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime                 @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  event        Event?                   @relation(fields: [eventId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "event_member_sections_event_fkey")
  applications EventMemberApplication[]

  @@index([eventId], map: "event_member_sections_event_idx")
  @@map("event_member_sections")
}

/// One application per person per section; once approved and visible it is the person's public team card.
model EventMemberApplication {
  id              String                      @id @db.VarChar(64)
  sectionId       String?                     @map("section_id") @db.VarChar(64)
  customEventName String?                     @map("custom_event_name") @db.VarChar(150)
  userId          String?                     @map("user_id") @db.VarChar(64)
  familyId        String?                     @map("family_id") @db.VarChar(255)
  memberId        String?                     @map("member_id") @db.VarChar(64)
  studentId       String?                     @map("student_id") @db.VarChar(255)
  photoUrl        String?                     @map("photo_url") @db.VarChar(500)
  name            String                      @db.VarChar(255)
  nameHi          String?                     @map("name_hi") @db.VarChar(255)
  villageHi       String?                     @map("village_hi") @db.VarChar(255)
  designation     String?                     @db.VarChar(150)
  designationHi   String?                     @map("designation_hi") @db.VarChar(150)
  mobile          String?                     @db.VarChar(20)
  mobileDigits    String?                     @map("mobile_digits") @db.VarChar(10)
  mobilePublic    Boolean                     @default(false) @map("mobile_public")
  email           String?                     @db.VarChar(255)
  emailPublic     Boolean                     @default(false) @map("email_public")
  village         String?                     @db.VarChar(255)
  area            String?                     @db.VarChar(150)
  showOnWebsite   Boolean                     @default(true) @map("show_on_website")
  status          String                      @default("PENDING") @db.VarChar(16)
  rejectionReason String?                     @map("rejection_reason") @db.VarChar(500)
  /// section + person while PENDING/APPROVED, else null: one active application per person per section.
  activeKey       String?                     @unique(map: "event_member_applications_active_key") @map("active_key") @db.VarChar(400)
  rosterId        String?                     @unique(map: "event_member_applications_roster_key") @map("roster_id") @db.VarChar(64)
  source          String                      @default("PUBLIC") @db.VarChar(16)
  sortOrder       Int                         @default(0) @map("sort_order")
  approvedById    String?                     @map("approved_by_id") @db.VarChar(64)
  approvedAt      DateTime?                   @map("approved_at") @db.DateTime(0)
  createdAt       DateTime                    @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime                    @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  section         EventMemberSection?         @relation(fields: [sectionId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "event_member_applications_section_fkey")
  member          FamilyMember?               @relation(fields: [memberId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "event_member_applications_member_fkey")
  logs            EventMemberApplicationLog[]

  @@index([sectionId, status, showOnWebsite], map: "event_member_applications_section_status_idx")
  @@index([userId], map: "event_member_applications_user_idx")
  @@index([mobileDigits], map: "event_member_applications_mobile_idx")
  @@index([memberId], map: "event_member_applications_member_idx")
  @@map("event_member_applications")
}

model EventMemberApplicationLog {
  id            String                 @id @db.VarChar(64)
  applicationId String                 @map("application_id") @db.VarChar(64)
  action        String                 @db.VarChar(32)
  actorId       String?                @map("actor_id") @db.VarChar(64)
  remarks       String?                @db.VarChar(500)
  changes       Json?
  createdAt     DateTime               @default(now()) @map("created_at") @db.DateTime(0)
  application   EventMemberApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "event_member_application_logs_application_fkey")

  @@index([applicationId, createdAt], map: "event_member_application_logs_application_idx")
  @@map("event_member_application_logs")
}

// The highest display number ever handed out per prefix (e.g. "TRF-"), so a number is never reused after the record
// that had it is deleted.
model DisplayIdCounter {
  prefix String @id @db.VarChar(40)
  last   Int

  @@map("display_id_counters")
}

// Public pages ("page:/about") and homepage sections ("section:home.updates") an admin switched off. No row = shown.
model SiteVisibility {
  key         String   @id @db.VarChar(120)
  visible     Boolean  @default(true)
  updatedById String?  @map("updated_by_id") @db.VarChar(64)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  @@map("site_visibility")
}

// Role-based admin access (Admin → Assign roles): which admin work a registered family member may do, and for which
// villages. The super admin (users.role = "admin") always has everything.
model AdminAccess {
  userId      String   @id @map("user_id") @db.VarChar(64)
  areas       Json
  villages    Json
  allVillages Boolean  @default(false) @map("all_villages")
  active      Boolean  @default(true)
  note        String?  @db.VarChar(500)
  grantedById String   @map("granted_by_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  @@map("admin_access")
}

/// Blood Help Network: a member who offered to donate blood (one row per login). Name, mobile and city come from the
/// member's own account and family record, never stored again here. `available` is the donor's own switch for being
/// suggested and notified. user_id is a plain column (no FK to the legacy users table), as in rental_listings.
model BloodDonor {
  id               String    @id @db.VarChar(64)
  userId           String    @unique @map("user_id") @db.VarChar(64)
  bloodGroup       String    @map("blood_group") @db.VarChar(3)
  lastDonationDate DateTime? @map("last_donation_date") @db.Date
  available        Boolean   @default(true)
  /// The donor's own name, mobile and city from the Become a Donor form (pre-filled from the profile, editable).
  /// Null for donors registered before the form asked: their account's name and mobile are used.
  name             String?   @db.VarChar(150)
  mobile           String?   @db.VarChar(10)
  city             String?   @db.VarChar(150)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([bloodGroup, available])
  @@map("blood_donors")
}

/// Blood Help Network: a blood requirement for a patient, with the person donors should contact. Only two states:
/// IN_PROGRESS and COMPLETED. Completion records who confirmed it (the requester, or an administrator who verified it)
/// and `history` keeps every status change as an audit trail.
model BloodRequest {
  id               String    @id @db.VarChar(64)
  reference        String    @unique @db.VarChar(20)
  userId           String    @map("user_id") @db.VarChar(64)
  patientName      String    @map("patient_name") @db.VarChar(150)
  bloodGroup       String    @map("blood_group") @db.VarChar(3)
  units            Int
  hospital         String    @db.VarChar(200)
  city             String    @db.VarChar(150)
  contactName      String    @map("contact_name") @db.VarChar(150)
  contactPhone     String    @map("contact_phone") @db.VarChar(10)
  status           String    @default("IN_PROGRESS") @db.VarChar(16)
  completedAt      DateTime? @map("completed_at") @db.DateTime(0)
  completedById    String?   @map("completed_by_id") @db.VarChar(64)
  completionSource String?   @map("completion_source") @db.VarChar(16)
  lastPromptedAt   DateTime? @map("last_prompted_at") @db.DateTime(0)
  history          Json?
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("blood_requests")
}

/// Every deletion made through the API (any member or administrator): who did it, when, what, and a copy of the deleted
/// record (secrets removed). Read by the super admin only; never edited or deleted through the API.
model AuditLog {
  id          String   @id @db.VarChar(64)
  action      String   @db.VarChar(16)
  resource    String   @db.VarChar(80)
  recordId    String?  @map("record_id") @db.VarChar(255)
  label       String?  @db.VarChar(255)
  path        String   @db.VarChar(500)
  actorUserId String?  @map("actor_user_id") @db.VarChar(64)
  actorName   String?  @map("actor_name") @db.VarChar(255)
  actorEmail  String?  @map("actor_email") @db.VarChar(255)
  actorRole   String?  @map("actor_role") @db.VarChar(24)
  snapshot    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@index([createdAt])
  @@index([resource, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}
