  otpExpiresAt        DateTime?           @map("otp_expires_at") @db.DateTime(0)
  photoUrl            String?             @map("photo_url") @db.Text
  // false while the mobile number was never proven by a code sent to it (the code went to the email fallback):
  // such a number can't be used to log in or reset the password and doesn't block anyone else from registering it.
  phoneVerified       Boolean             @default(true) @map("phone_verified")
  /// Email change in progress: the new address, its code (SHA-256), expiry and wrong tries.
  pendingEmail          String?   @map("pending_email") @db.VarChar(255)
  pendingEmailCodeHash  String?   @map("pending_email_code_hash") @db.VarChar(64)
  pendingEmailExpiresAt DateTime? @map("pending_email_expires_at") @db.DateTime(0)
